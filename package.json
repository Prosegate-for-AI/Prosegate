{
  "name": "prosegate-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:dashboard": "vitest run --config vitest.browser.config.ts",
    "install:dashboard-browser": "node apps/dashboard/test/install-browser.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "eval:rules": "tsx eval/runners/eval-rules.ts",
    "eval:publish-pack": "tsx eval/runners/publish-pack.ts",
    "eval:corpus": "tsx eval/runners/phase6.ts corpus",
    "eval:generate": "tsx eval/runners/phase6.ts generate",
    "eval:annotate": "tsx eval/runners/annotate.ts",
    "eval:import": "tsx eval/runners/phase6.ts import",
    "eval:reviewer": "tsx eval/runners/phase6.ts reviewer",
    "eval:writing": "tsx eval/runners/eval-writing.ts",
    "eval:e2e": "tsx eval/runners/phase6.ts e2e",
    "eval:release": "tsx eval/runners/phase6.ts release",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prosegate-for-AI/Prosegate.git"
  }
}
