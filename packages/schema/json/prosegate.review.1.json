{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "prosegate.review/1"
    },
    "text": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "properties": {
        "user_message": {
          "type": "string",
          "maxLength": 2000
        },
        "style_constraints": {
          "type": "string",
          "maxLength": 1500
        },
        "mode": {
          "type": "string",
          "enum": [
            "interactive",
            "headless"
          ]
        }
      },
      "required": [
        "user_message",
        "style_constraints",
        "mode"
      ],
      "additionalProperties": false
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,31}\\/[a-z0-9-]{1,31}$"
    },
    "pass": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "rules",
          "reviewer"
        ]
      }
    },
    "session_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{10}$"
      }
    }
  },
  "required": [
    "schema",
    "text",
    "context",
    "profile_id",
    "pass",
    "stages",
    "session_id",
    "turn_id",
    "prior_findings"
  ],
  "additionalProperties": false,
  "$comment": "Producer schema; consumers must tolerate unknown optional fields and enum values per 03 Versioning.",
  "title": "prosegate.review/1"
}
