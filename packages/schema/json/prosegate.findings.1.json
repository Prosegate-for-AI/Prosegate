{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "prosegate.findings/1"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "skipped"
      ]
    },
    "skipped_reason": {
      "type": "string",
      "enum": [
        "below_floor",
        "no_prose",
        "advisory_mode",
        "pass_cap",
        "reviewer_unavailable"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,31}\\/[a-z0-9-]{1,31}$"
        },
        "version": {
          "type": "string"
        },
        "resolved_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,31}\\/[a-z0-9-]{1,31}$"
          }
        }
      },
      "required": [
        "id",
        "version",
        "resolved_from"
      ],
      "additionalProperties": false
    },
    "pass": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prose",
              "code",
              "table",
              "tool_output",
              "quote"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "kind",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{10}$"
          },
          "span": {
            "type": "object",
            "properties": {
              "segment_id": {
                "type": "string",
                "pattern": "^s[0-9]+$"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "segment_id",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          },
          "category": {
            "type": "string",
            "enum": [
              "filler",
              "hedge",
              "vocab",
              "triad",
              "structure",
              "repetition",
              "vague_claim",
              "unsupported_claim",
              "register"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "rule",
              "reviewer"
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "info"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "instruction": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "remove",
                  "replace",
                  "shorten",
                  "specify",
                  "merge",
                  "restructure",
                  "rephrase",
                  "cite_or_soften_or_remove"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "text"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile_origin": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,31}\\/[a-z0-9-]{1,31}$"
          }
        },
        "required": [
          "id",
          "span",
          "category",
          "source",
          "rule_id",
          "severity",
          "confidence",
          "instruction",
          "evidence",
          "profile_origin"
        ],
        "additionalProperties": false
      }
    },
    "cleared": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{10}$"
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "prose_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sentence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "findings_by_category": {
          "type": "object",
          "properties": {
            "filler": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hedge": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "vocab": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "triad": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "structure": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "repetition": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "vague_claim": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unsupported_claim": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "register": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "rule_packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,31}$"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "latency_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "model",
                "latency_ms",
                "input_tokens",
                "output_tokens"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rules_latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "prose_chars",
        "sentence_count",
        "findings_by_category",
        "rule_packs",
        "reviewer",
        "rules_latency_ms"
      ],
      "additionalProperties": false
    },
    "feedback_text": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "verdict",
    "profile",
    "pass",
    "segments",
    "findings",
    "cleared",
    "stats",
    "feedback_text"
  ],
  "additionalProperties": false,
  "$comment": "Producer schema; consumers must tolerate unknown optional fields and enum values per 03 Versioning. Cross-field invariants (spans, order, forks, caps, feedback_text equality) are enforced by @prosegate/schema and are not expressible here.",
  "title": "prosegate.findings/1"
}
